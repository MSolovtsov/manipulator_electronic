		(at -234.95 411.48 0)
		(effects
			(font
				(face "GOST 2.304")
				(size 2.5 2.5)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "4d42f7dd-639d-45ce-9257-0f9ce6c2215c")
	)
	(text "   проверить, что он не совпадает с адресом мультиплексора TCA9548A (0x70). Вывод 13 (INT) не используется."
