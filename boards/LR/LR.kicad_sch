			(justify left bottom)
		)
		(uuid "11985400-146c-48dc-86ae-091cdf1928fd")
	)
	(text "   IN1, IN2, SDA, SCL звена с платы MC на эту панель. В обычном режиме панель отключена от звена."
		(exclude_from_sim no)
		(at -234.95 349.25 0)
