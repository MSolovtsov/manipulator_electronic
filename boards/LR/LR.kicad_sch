		(uuid "0934c99a-fdd8-412b-985e-0b8f9be0e62f")
	)
	(text "2. Защита каждой линии: панель — последовательный резистор 100 Ом (E-052) — ограничитель BAT54S (E-053) на 3,3 В"
		(exclude_from_sim no)
		(at -234.95 353.695 0)
