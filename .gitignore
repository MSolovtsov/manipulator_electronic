# --- KiCad: служебные файлы ---
*-backups/
_autosave-*
*.lck
~*.lck
# локальная история KiCad 10 (внутри — свой .git)
.history/
*.kicad_prl
fp-info-cache
# остатки устаревших форматов (KiCad 5/6)
*.bak
*.sch-bak
*-cache.lib
*-rescue.*

# --- Пересоздаваемые выходные файлы ---
*.gbr
*.gbrjob
*.drl
*.rpt
*.net
*.pdf
# превью платы из scripts/check_pcb.py
*_preview.png
# замороженные артефакты изготовленных ревизий хранятся
!boards/*/release/**

# --- Python ---
__pycache__/
*.pyc

# --- ОС и редакторы ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# заглушки для пустых каталогов никогда не игнорируются
!.gitkeep

# Временные файлы блокировки Excel/LibreOffice
~$*
.~lock.*#
